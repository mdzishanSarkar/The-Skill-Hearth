# Server (server/.env)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SITE_URL=http://localhost:5000
MONGODB_URI=mongodb://localhost:27017/skillshare-local
JWT_SECRET=change-me-in-production

# Admin signup code — required to register an admin account
ADMIN_SIGNUP_CODE=change-me

# Gmail SMTP (use an App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM="The Skill Hearth <no-reply@gmail.com>"

# Client (client/.env)
VITE_API_URL=http://localhost:5000/api

# Redis (token blacklist + login lockout). Falls back to Mongo/in-memory when unset.
REDIS_URL=redis://localhost:6379

# Cloudinary (avatar uploads). Falls back to local disk (server/uploads) when unset.
# CLOUDINARY_CLOUD_NAME=xxx
# CLOUDINARY_API_KEY=xxx
# CLOUDINARY_API_SECRET=xxx

# Stripe (billing). Required for Pro subscriptions and tipping.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
# STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
