# Server (server/.env)
PORT=5000
NODE_ENV=development
CLIENT_URL=https://the-skill-hearth.onrender.com,http://localhost:5174
SITE_URL=https://the-skill-hearth.onrender.com
MONGODB_URI=mongodb://localhost:27017/the-skill-hearth-local
JWT_SECRET=change-me-in-production

# Admin signup code — required to register an admin account
ADMIN_SIGNUP_CODE=change-me

# Production email provider recommendation:
# Gmail SMTP commonly times out from Render due to outbound egress restrictions.
# Use a dedicated transactional provider such as Resend, SendGrid, or Brevo
# instead of Gmail for production email delivery.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-api-key-or-password
# EMAIL_FROM="The Skill Hearth <no-reply@yourdomain.com>"

# Recommended on Render: Resend uses HTTPS/443 instead of SMTP ports.
# When RESEND_API_KEY is set, it takes priority over SMTP settings.
# RESEND_API_KEY=re_xxxxxxxxx

# Client (client/.env)
VITE_API_URL=https://the-skill-hearth.onrender.com/api

# Redis (token blacklist + login lockout). Falls back to Mongo/in-memory when unset.
REDIS_URL=redis://localhost:6379

# Cloudinary (avatar uploads). Falls back to local disk (server/uploads) when unset.
# CLOUDINARY_CLOUD_NAME=xxx
# CLOUDINARY_API_KEY=xxx
# CLOUDINARY_API_SECRET=xxx

# Stripe (billing). Required for tipping and skill promotion.
# STRIPE_SECRET_KEY=sk_test_xxx

